{
  "contract_version": "1.1.0",
  "dataset_version": "2.0.1",
  "canonical_storage": "Parquet with Zstandard compression",
  "raw_layer": {
    "path": "data/records/**/*.jsonl",
    "mutable": false,
    "schema": "schema/record.schema.json"
  },
  "identity_rules": {
    "question_id": "prompt_id 存在时使用固定格式编号；缺失时使用规范化问题文本的 SHA-256 前缀",
    "source_id": "规范域名的 SHA-256",
    "page_id": "规范 URL 的 SHA-256",
    "response_id": "旧数据无法恢复回答边界，保持为空"
  },
  "tables": {
    "questions": {"grain_cn": "每个规范问题一行", "primary_key": ["question_id"]},
    "question_labels": {"grain_cn": "每个问题与标签一行", "primary_key": ["question_id", "label_dimension", "label_value"]},
    "ai_platforms": {"grain_cn": "每个 AI 平台代码一行", "primary_key": ["platform_code"]},
    "sources": {
      "grain_cn": "每个规范主域名一行",
      "primary_key": ["source_id"],
      "classification_fields": [
        "source_category_l1",
        "source_category_l1_cn",
        "source_type",
        "source_type_cn",
        "classification_status",
        "classification_method",
        "classification_confidence",
        "classification_evidence"
      ]
    },
    "pages": {"grain_cn": "每个规范 URL 一行", "primary_key": ["page_id"]},
    "responses": {"grain_cn": "每次完整 AI 回答一行；当前版本为空表", "primary_key": ["response_id"]},
    "citation_observations": {"grain_cn": "每条原始引用观察一行", "primary_key": ["citation_id"]}
  },
  "source_classification": {
    "reference_path": "data/reference/source_types.csv",
