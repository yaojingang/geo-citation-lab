    "reference_governance": {
      "approved_combinations": [
        {"classification_method": "legacy_curated", "classification_status": "curated", "classification_confidence": "high"},
        {"classification_method": "manual_review", "classification_status": "reviewed", "classification_confidence": "high"},
        {"classification_method": "manual_review", "classification_status": "reviewed", "classification_confidence": "medium"},
        {"classification_method": "manual_review", "classification_status": "reviewed_unclassified", "classification_confidence": "low"}
      ],
      "preflight_cn": "构建开始时校验字段完整性、规范域名唯一性、一级与二级配对、中文标签、治理组合、未分类状态语义及非空证据；任一失败即终止构建。"
    },
    "fallback_rules": [
      "精确域名映射优先。",
      "未命中精确映射的 gov.cn 或 .gov.cn 域名使用 domain_suffix_rule 归入 government_public/government_public。",
      "其余域名使用 default_unclassified 归入 unclassified_long_tail/unclassified。"
    ]
  },
  "representative_aggregate_policy_cn": "所有众数代表值在频数并列时按字段值升序选择；所有输出查询使用完整稳定排序键。该规则覆盖问题、信源、页面、页面特征和分析集市。",
  "null_policy_cn": "可选元数据未提供时保持为空，并通过解析状态与 availability_flags 说明字段可用性。记录继续用于不依赖该字段的分析。quality_flags 仅标记需要清洗或复核的异常与重复状态。清洗过程不猜测发布时间、回答边界和模型版本。",
  "deduplication_policy_cn": "事实表保留所有原始观察；is_preferred_exact_record 标记每组 record_hash 的首条记录；分析集市使用该标记去除精确重复。"
}
